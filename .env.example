# Sunucu portu (Railway otomatik enjekte eder, yerelde 3000)
PORT=3000

# Çalışma ortamı (development | production)
NODE_ENV=development

# Uygulama URL'si (Railway veya AI Studio tarafından sağlanır)
APP_URL="MY_APP_URL"

# Yönetici paneli (/admingiris) kimlik bilgileri (boş bırakılırsa ilk kurulumda tanımlanır)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Güvenlik ve gizlilik ayarları
DAILY_MATCH_LIMIT=50
REPORT_RETENTION_HOURS=72
SECURITY_LOG_TTL_HOURS=24
AUTO_BAN_REPORT_THRESHOLD=3
TEMP_BAN_MINUTES=60
